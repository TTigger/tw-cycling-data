---
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.tsx";
const siteTitle = "台灣公路車賽事成績儀表板";
const {
  title = siteTitle,
  description = "台灣公路車賽事成績資料探索與視覺化(2009–2026)",
  ogImage = "/og.png",
  ogType = "website",
} = Astro.props;
// Absolute URLs for canonical + OG (Astro.site set in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      // set theme before paint to avoid a flash
      (() => {
        try {
          const s = localStorage.getItem("theme");
          const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) { /* no-op */ }
      })();
    </script>
  </head>
  <body class="bg-bg text-ink font-body">
    <header class="border-b border-border px-4 py-3 sm:px-6 sm:py-4">
      <div class="flex items-center justify-between gap-3">
        <a href="/" class="font-display text-lg text-ink sm:text-xl">{siteTitle}</a>
        <div class="flex items-center gap-2">
          <CommandPalette client:load />
          <button id="themeToggle" type="button" aria-label="切換深色模式"
            class="rounded-lg border border-border px-2.5 py-1.5 text-sm leading-none text-muted hover:border-accent hover:text-accent">🌙</button>
          <button id="navToggle" type="button" aria-label="開啟選單" aria-controls="siteNav" aria-expanded="false"
            class="rounded-lg border border-border px-2.5 py-1.5 text-lg leading-none text-muted hover:border-accent hover:text-accent sm:hidden">☰</button>
        </div>
      </div>
      <nav id="siteNav" class="mt-2 hidden flex-col gap-0.5 text-sm text-muted sm:mt-1 sm:flex sm:flex-row sm:flex-wrap sm:gap-x-4 sm:gap-y-1">
        <a href="/" class="py-1 hover:text-accent">總覽</a><a href="/explore" class="py-1 hover:text-accent">探索</a>
        <a href="/race" class="py-1 hover:text-accent">賽事</a><a href="/series" class="py-1 hover:text-accent">系列</a><a href="/athletes" class="py-1 hover:text-accent">選手</a><a href="/teams" class="py-1 hover:text-accent">車隊</a>
        <a href="/climbs" class="py-1 hover:text-accent">傳奇爬坡</a><a href="/insights" class="py-1 hover:text-accent">洞察</a>
        <a href="/overseas" class="py-1 hover:text-accent">海外賽</a><a href="/coverage" class="py-1 hover:text-accent">資料涵蓋</a>
      </nav>
    </header>
    <script is:inline>
      (() => {
        const b = document.getElementById("navToggle"), n = document.getElementById("siteNav");
        if (!b || !n) return;
        const set = (open) => { n.style.display = open ? "flex" : ""; b.setAttribute("aria-expanded", String(open)); };
        b.addEventListener("click", () => set(n.style.display !== "flex"));
        n.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
      })();
      (() => {
        const t = document.getElementById("themeToggle");
        if (!t) return;
        const sync = () => { t.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙"; };
        sync();
        t.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) { /* no-op */ }
          window.dispatchEvent(new Event("themechange"));  // re-theme charts
          sync();
        });
      })();
    </script>
    <main class="mx-auto min-h-[80vh] max-w-6xl px-4 py-6 sm:px-6 sm:py-8"><slot /></main>
    <footer class="mt-12 border-t border-border px-4 py-6 text-xs text-muted sm:px-6">
      <div class="mx-auto max-w-6xl space-y-1">
        <p>資料來源:中華民國自行車騎士協會(cyclist.org.tw)、Bravelog 運動趣(bravelog.tw)、中華民國自由車協會(cycling.org.tw)公開賽事成績,涵蓋 2009–2026。</p>
        <p>選手姓名已去識別化(僅顯示首尾字,如 林○宇)。本站為非營利之資料整理與視覺化;如為當事人欲將成績下架,請與本站聯絡。</p>
        <p>成績僅供參考,實際以各主辦單位公告為準。</p>
      </div>
    </footer>
  </body>
</html>
