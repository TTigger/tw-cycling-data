---
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.tsx";
const siteTitle = "台灣公路車賽事成績儀表板";
const {
  title = siteTitle,
  description = "台灣公路車賽事成績資料探索與視覺化(2009–2026)",
  ogImage = "/og.png",
  ogType = "website",
} = Astro.props;
// Absolute URLs for canonical + OG (Astro.site set in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Site navigation: three things people look up, then analysis and open data.
type NavItem = { href: string; label: string; hint?: string };
type NavGroup = { label: string; href?: string; items?: NavItem[] };
const NAV: NavGroup[] = [
  { label: "賽事", items: [
    { href: "/race", label: "所有賽事", hint: "成績、完賽時間分布、歷年比較" },
    { href: "/series", label: "系列", hint: "96聯賽、臺灣自行車聯賽…" },
    { href: "/overseas", label: "海外賽", hint: "富士山登山賽等" },
  ] },
  { label: "選手", href: "/athletes" },
  { label: "車隊", href: "/teams" },
  { label: "分析", items: [
    { href: "/explore", label: "探索", hint: "自由篩選全部成績" },
    { href: "/benchmark", label: "分齡對標", hint: "這個成績在同齡排第幾" },
    { href: "/trends", label: "長期趨勢", hint: "女性參與、分齡組成、跨年完賽時間" },
    { href: "/climbs", label: "傳奇爬坡", hint: "爬坡難度與紀錄" },
    { href: "/insights", label: "洞察", hint: "數據小故事" },
  ] },
  { label: "開放資料", items: [
    { href: "/api", label: "API 與下載", hint: "CC BY 4.0" },
    { href: "/coverage", label: "資料涵蓋", hint: "收錄了哪些賽事、還缺哪些" },
  ] },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isOn = (href: string) => path === href || path.startsWith(href + "/");
const groupOn = (g: NavGroup) => (g.href ? isOn(g.href) : (g.items ?? []).some((i) => isOn(i.href)));
const ogImageUrl = new URL(ogImage, Astro.site).href;
---
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      // set theme before paint to avoid a flash
      (() => {
        try {
          const s = localStorage.getItem("theme");
          const dark = s ? s === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) { /* no-op */ }
      })();
    </script>
  </head>
  <body class="bg-bg text-ink font-body">
    <header class="border-b border-border px-4 py-3 sm:px-6 sm:py-4">
      <div class="flex items-center justify-between gap-3">
        <a href="/" class="font-mono text-sm font-medium uppercase tracking-[0.12em] text-ink sm:text-base">TW·CYCLING·DATA</a>
        <div class="flex items-center gap-2">
          <CommandPalette client:load />
          <button id="themeToggle" type="button" aria-label="切換深色模式"
            class="rounded-lg border border-border px-2.5 py-1.5 text-sm leading-none text-muted hover:border-accent hover:text-accent">🌙</button>
          <button id="navToggle" type="button" aria-label="開啟選單" aria-controls="siteNav" aria-expanded="false"
            class="rounded-lg border border-border px-2.5 py-1.5 text-lg leading-none text-muted hover:border-accent hover:text-accent sm:hidden">☰</button>
        </div>
      </div>
      <nav id="siteNav" aria-label="主選單"
        class="mt-2 hidden flex-col gap-3 text-sm sm:mt-2 sm:flex sm:flex-row sm:items-center sm:gap-1">
        {NAV.map((g) => g.href ? (
          <a href={g.href} aria-current={groupOn(g) ? "page" : undefined}
            class:list={["rounded-md py-1 sm:px-2.5", groupOn(g) ? "text-ink font-medium" : "text-muted hover:text-accent"]}>{g.label}</a>
        ) : (
          <details class="navgroup group relative">
            <summary class:list={["flex cursor-pointer list-none items-center gap-1 rounded-md py-1 sm:px-2.5 [&::-webkit-details-marker]:hidden",
              groupOn(g) ? "text-ink font-medium" : "text-muted hover:text-accent"]}>
              {g.label}<span aria-hidden="true" class="text-[10px] transition-transform group-open:rotate-180">▾</span>
            </summary>
            <div class="mt-1 grid gap-0.5 border-l border-border pl-3 sm:absolute sm:left-0 sm:z-40 sm:mt-2 sm:w-64 sm:rounded-xl sm:border sm:bg-surface sm:p-2 sm:pl-2 sm:shadow-lg">
              {(g.items ?? []).map((i) => (
                <a href={i.href} aria-current={isOn(i.href) ? "page" : undefined}
                  class:list={["block rounded-lg px-2 py-1.5", isOn(i.href) ? "bg-bg text-ink" : "text-ink hover:bg-bg hover:text-accent"]}>
                  <span class="block">{i.label}</span>
                  {i.hint && <span class="block text-xs text-muted">{i.hint}</span>}
                </a>
              ))}
            </div>
          </details>
        ))}
      </nav>
      <div class="relative mt-2 h-px w-full bg-border">
        <div id="scrollRidge" class="absolute inset-y-0 left-0 bg-accent" style="width:0" aria-hidden="true"></div>
      </div>
    </header>
    <script is:inline>
      (() => {
        const b = document.getElementById("navToggle"), n = document.getElementById("siteNav");
        if (!b || !n) return;
        const set = (open) => { n.style.display = open ? "flex" : ""; b.setAttribute("aria-expanded", String(open)); };
        b.addEventListener("click", () => set(n.style.display !== "flex"));
        n.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
      })();
      (() => {
        // desktop dropdowns: one open at a time; close on outside click / Escape
        const groups = [...document.querySelectorAll("details.navgroup")];
        groups.forEach((d) => d.addEventListener("toggle", () => {
          if (d.open) groups.forEach((o) => { if (o !== d) o.open = false; });
        }));
        document.addEventListener("click", (e) => {
          groups.forEach((d) => { if (d.open && !d.contains(e.target)) d.open = false; });
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") groups.forEach((d) => { d.open = false; });
        });
      })();
      (() => {
        const t = document.getElementById("themeToggle");
        if (!t) return;
        const sync = () => { t.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙"; };
        sync();
        t.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) { /* no-op */ }
          window.dispatchEvent(new Event("themechange"));  // re-theme charts
          sync();
        });
      })();
      (() => {
        const bar = document.getElementById("scrollRidge");
        if (!bar) return;
        let raf = 0;
        const update = () => {
          raf = 0;
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0;
          bar.style.width = (p * 100).toFixed(2) + "%";
        };
        const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll, { passive: true });
        update();
      })();
    </script>
    <main class="mx-auto min-h-[80vh] max-w-6xl px-4 py-6 sm:px-6 sm:py-8"><slot /></main>
    <footer class="mt-16 border-t border-border px-4 py-8 text-xs text-muted sm:px-6">
      <div class="mx-auto max-w-6xl space-y-2">
        <p class="font-mono uppercase tracking-[0.08em] text-muted">TW·CYCLING·DATA · 2009–2026 · CC BY 4.0</p>
        <p>資料來源:中華民國自行車騎士協會(cyclist.org.tw)、Bravelog 運動趣(bravelog.tw)、中華民國自由車協會(cycling.org.tw)等公開賽事成績。</p>
        <p>選手姓名已去識別化(僅顯示首尾字,如 林○宇)。本站為非營利之資料整理與視覺化;當事人如欲下架,請與本站聯絡。</p>
        <p>成績僅供參考,實際以各主辦單位公告為準。</p>
        <p class="font-mono">
          <a class="hover:text-accent" href="/api">API</a> ·
          <a class="hover:text-accent" href="/coverage">資料涵蓋</a> ·
          <a class="hover:text-accent" href="https://github.com/TTigger/tw-cycling-data">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
