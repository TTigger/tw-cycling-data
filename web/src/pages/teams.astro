---
import Base from "../layouts/Base.astro";
import TeamsApp from "../components/teams/TeamsApp.tsx";
---
<Base title="車隊 | 台灣公路車賽事成績儀表板">
  <h1 class="font-display text-3xl">車隊</h1>
  <p class="mt-2 mb-6 text-muted">瀏覽各車隊的車手名單、隊史最佳戰績與活躍年表。車隊由成績欄位的隊名歸併(涵蓋約 46% 的成績),姓名已去識別化,身分以姓名+車隊推斷,可能含同名,僅供參考。</p>
  <TeamsApp client:only="react" />
</Base>
